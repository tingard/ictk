{
  "name": "ictk",
  "version": "0.0.1",
  "description": "Composable, interactive map-marker icons for MapLibre GL and deck.gl, generalized from NATO's own guidance for map icons.",
  "keywords": [
    "react",
    "react-component",
    "maplibre",
    "maplibre-gl",
    "deck.gl",
    "map",
    "map-marker",
    "marker",
    "icon",
    "map-icon",
    "gis",
    "geospatial",
    "military-symbology",
    "nato"
  ],
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=20"
  },
  "files": ["dist", "src/styles.css"],
  "main": "./dist/ictk.js",
  "module": "./dist/ictk.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ictk.js"
    },
    "./style.css": "./src/styles.css"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.62.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0",
    "vitest": "^2.1.0"
  }
}
