{
  "name": "@tingard/ictk-react",
  "version": "0.0.1",
  "description": "Composable, interactive map-marker icons for MapLibre GL and deck.gl, generalized from NATO's own guidance for map icons.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tingard/ictk.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "react-component",
    "maplibre",
    "maplibre-gl",
    "deck.gl",
    "map",
    "map-marker",
    "marker",
    "icon",
    "map-icon",
    "gis",
    "geospatial",
    "military-symbology",
    "nato"
  ],
  "type": "module",
  "sideEffects": ["*.css"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "main": "./dist/ictk-react.js",
  "module": "./dist/ictk-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ictk-react.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/fix-dts-extensions.mjs dist && node scripts/copy-css.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "dependencies": {
    "@tingard/ictk-core": "workspace:*"
  }
}
